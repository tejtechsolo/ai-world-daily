# Local development environment
# Copy to .env.local and fill in real values. NEVER commit .env.local.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_world_daily?schema=public"

# Auth.js v5
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Automation safety
AUTOMATION_ENABLED="true"
AUTO_PUBLISH_ENABLED="false"
MINIMUM_QUALITY_SCORE="85"
MINIMUM_FACT_SCORE="90"
MINIMUM_SOURCE_SCORE="85"
MINIMUM_SEO_SCORE="80"
