generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArticleStatus { IDEA DISCOVERED RESEARCHING DRAFT FACT_CHECK EDITORIAL_REVIEW SEO_REVIEW APPROVED SCHEDULED PUBLISHED ARCHIVED REJECTED }
enum SourceType { OFFICIAL GOVERNMENT RESEARCH NEWS COMPANY BLOG SOCIAL DATA OTHER }
enum VerificationStatus { VERIFIED PARTIALLY_VERIFIED UNVERIFIED CONTRADICTED }
enum ReviewType { FACT SEO ORIGINALITY QUALITY EDITORIAL }
enum ReviewStatus { PENDING PASSED FAILED }

author User {
  id String @id @default(cuid())
  email String @unique
  name String?
  image String?
  role String @default("EDITOR")
  articles Article[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  description String?
  articles Article[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  articles Article[]
}

model Article {
  id String @id @default(cuid())
  title String
  slug String @unique
  excerpt String?
  content String
  status ArticleStatus @default(IDEA)
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  authorId String
  author User @relation(fields: [authorId], references: [id])
  tags Tag[]
  featuredImage Image? @relation(fields: [featuredImageId], references: [id])
  featuredImageId String? @unique
  primaryKeyword String?
  secondaryKeywords String[]
  seoTitle String?
  metaDescription String?
  canonicalUrl String?
  readingTime Int?
  wordCount Int?
  originalityScore Int?
  factScore Int?
  sourceScore Int?
  seoScore Int?
  qualityScore Int?
  isFeatured Boolean @default(false)
  isTrending Boolean @default(false)
  publishedAt DateTime?
  scheduledAt DateTime?
  versions ArticleVersion[]
  sources ArticleSource[]
  reviews ContentReview[]
  publications Publication[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, scheduledAt])
  @@index([categoryId, publishedAt])
}

model ArticleVersion {
  id String @id @default(cuid())
  articleId String
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  content String
  title String
  createdAt DateTime @default(now())
}

model Source {
  id String @id @default(cuid())
  name String
  domain String
  url String
  sourceType SourceType
  trustScore Int @default(50)
  isOfficial Boolean @default(false)
  isActive Boolean @default(true)
  articles ArticleSource[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ArticleSource {
  id String @id @default(cuid())
  articleId String
  sourceId String
  sourceUrl String
  claim String?
  publishedAt DateTime?
  accessedAt DateTime @default(now())
  relevanceScore Int?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  source Source @relation(fields: [sourceId], references: [id])
  @@unique([articleId, sourceId])
}

model Keyword {
  id String @id @default(cuid())
  keyword String @unique
  searchVolume Int?
  difficulty Int?
  intent String?
  category String?
  priority Int @default(0)
  status String @default("NEW")
}

model SEOData {
  id String @id @default(cuid())
  articleId String @unique
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  titleScore Int?
  descriptionScore Int?
  headingScore Int?
  keywordScore Int?
  internalLinkScore Int?
  readabilityScore Int?
  schemaScore Int?
  seoScore Int?
  generatedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Image {
  id String @id @default(cuid())
  url String
  altText String?
  sourceType String
  creator String?
  license String?
  article Article?
  createdAt DateTime @default(now())
}

model ContentReview {
  id String @id @default(cuid())
  articleId String
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  reviewType ReviewType
  reviewerType String
  originalityScore Int?
  factualScore Int?
  seoScore Int?
  qualityScore Int?
  issues String[]
  recommendations String[]
  status ReviewStatus @default(PENDING)
  createdAt DateTime @default(now())
  completedAt DateTime?
}

model Publication {
  id String @id @default(cuid())
  articleId String
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  channel String
  status String @default("PENDING")
  publishedAt DateTime?
  externalId String?
  createdAt DateTime @default(now())
}

model Subscriber {
  id String @id @default(cuid())
  email String @unique
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
}

model Newsletter {
  id String @id @default(cuid())
  subject String
  content String
  status String @default("DRAFT")
  scheduledAt DateTime?
  sentAt DateTime?
  createdAt DateTime @default(now())
}

model SocialPost {
  id String @id @default(cuid())
  articleId String?
  platform String
  content String
  status String @default("DRAFT")
  scheduledAt DateTime?
  publishedAt DateTime?
  externalId String?
}

model Analytics {
  id String @id @default(cuid())
  articleId String?
  date DateTime
  views Int @default(0)
  users Int @default(0)
  sessions Int @default(0)
  clicks Int @default(0)
  createdAt DateTime @default(now())
  @@unique([articleId, date])
}

model SearchConsoleMetric {
  id String @id @default(cuid())
  date DateTime
  query String?
  page String?
  clicks Int @default(0)
  impressions Int @default(0)
  ctr Float @default(0)
  position Float @default(0)
  createdAt DateTime @default(now())
}

model AutomationJob {
  id String @id @default(cuid())
  jobType String
  status String @default("PENDING")
  startedAt DateTime?
  completedAt DateTime?
  itemsProcessed Int @default(0)
  itemsSucceeded Int @default(0)
  itemsFailed Int @default(0)
  errorMessage String?
  metadata Json?
  createdAt DateTime @default(now())
}
